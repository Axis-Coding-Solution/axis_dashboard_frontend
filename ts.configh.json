{
  "compilerOptions": {
    "target": "es5",
    "lib": ["dom", "es5", "es2015", "esnext"],
    "allowJs": true,
    "checkJs": false,
    "jsx": "react-jsx",
    "strict": false,
    "esModuleInterop": true,
    "skipLibCheck": false,
    "noEmit": true,
    "moduleResolution": "node",
    "types": ["node", "@tanstack/react-query", "vite/client"] 
  },
  "include": ["src/**/*"],
  "exclude": ["node_modules", "**/*.test.ts"]
}
